{
  "description": "One secret-pattern list. 'token' patterns are high-confidence key formats: the commit hooks and the Assert-AgenticFlow secrets check block them. 'heuristic' patterns also catch config-shaped secrets; only /review-changes staging (Select-TicketStagePaths.ps1) uses them, because this repo's own docs and scripts name them. Patterns must work in both .NET and JavaScript regex; set ignoreCase instead of an inline (?i). A line containing secret-scan:allow is exempt from the commit hooks and the secrets check.",
  "patterns": [
    { "name": "nuget-cleartext-password", "kind": "heuristic", "pattern": "ClearTextPassword" },
    { "name": "password-assignment", "kind": "heuristic", "ignoreCase": true, "pattern": "\\bpassword\\s*=\\s*[^;\"'\\s<>$%{}]{4,}" },
    { "name": "azure-devops-pat-legacy", "kind": "token", "pattern": "\\b[a-z2-7]{52}\\b" },
    { "name": "azure-devops-pat", "kind": "token", "pattern": "\\b[A-Za-z0-9]{76}AZDO[A-Za-z0-9]{4}\\b" },
    { "name": "private-key", "kind": "token", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "name": "github-token", "kind": "token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b" },
    { "name": "github-fine-grained-token", "kind": "token", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b" },
    { "name": "anthropic-api-key", "kind": "token", "pattern": "\\bsk-ant-[A-Za-z0-9_-]{20,}" },
    { "name": "aws-access-key", "kind": "token", "pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b" },
    { "name": "azure-storage-key", "kind": "token", "pattern": "AccountKey=[A-Za-z0-9+/]{40,}={0,2}" },
    { "name": "sonar-token", "kind": "token", "pattern": "\\bsq[pua]_[A-Za-z0-9]{40}\\b" },
    { "name": "slack-token", "kind": "token", "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}" }
  ]
}
