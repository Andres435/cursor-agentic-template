{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./adapters/cursor/hooks/session-context.js",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./adapters/cursor/hooks/git-commit-ticket.js",
        "matcher": "\\bgit(\\.exe)?\\b[^\\n]*\\b(commit|add)\\b",
        "timeout": 8
      },
      {
        "command": "node ./adapters/cursor/hooks/git-push-agentic-flow.js",
        "matcher": "\\bgit(\\.exe)?\\b[^\\n]*\\bpush\\b",
        "timeout": 120
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./adapters/cursor/hooks/ticket-command-nudge.js",
        "matcher": "start-ticket|implement|review-changes|complete-task|prep-pr|address-pr-comments",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "node ./adapters/cursor/hooks/closeout-read-guard.js",
        "matcher": "Read",
        "timeout": 3
      }
    ],
    "preCompact": [
      {
        "command": "node ./adapters/cursor/hooks/precompact-nudge.js",
        "timeout": 3
      }
    ]
  }
}
